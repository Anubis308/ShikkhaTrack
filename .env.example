VITE_BLOCKS_API_URL=https://blocksapi.slsblx.com
# This project's tenant id. Sent as the x-blocks-key header on every
# Blocks API call, and as tenant_id on the OIDC login request -- both
# mean the same thing: which Blocks tenant this app belongs to.
VITE_BLOCKS_X_BLOCKS_KEY=Dbe0eefff372a4ed3a61e3eeb8e0d454f
VITE_BLOCKS_APP_DOMAIN=https://drdajd.slsblx.com
VITE_BLOCKS_OIDC_URL=https://iam.seliseblocks.com
# Public browser OIDC client (hosted IAM IdP flow, no secret). Register it in Blocks IAM
# with redirect_uris for both your dev origin and VITE_BLOCKS_APP_DOMAIN.
VITE_BLOCKS_OIDC_CLIENT_ID=05be13b1-d4c9-4281-9ad5-1c6442200805
VITE_BLOCKS_OIDC_SCOPE=openid profile
# Set to your project's real domain (Project/Gets -> applications[].domain,
# no scheme) to test OIDC login locally over HTTPS -- see README.md.
VITE_BLOCKS_DEV_HOST=drdajd.slsblx.com
VITE_BLOCKS_DEV_PORT=5173
# Production Blocks Logic webhook (path-based: tenant is in the URL).
# POST { "prompt": "..." } with Content-Type and x-blocks-key (tenant routing).
# Trigger authType=none for now (no Authorization). Bound by AiCallLog (30/hour).
VITE_AI_WORKFLOW_WEBHOOK_URL=https://logic.seliseblocks.com/api/Workflow/webhook/Dbe0eefff372a4ed3a61e3eeb8e0d454f/7e95943fcff74634897b8e2a4c5f81ef/8cb1b6f4651f4c058bb375a33e576196
# Local-only debug UI (e.g. Profile "View raw response"). Leave unset in deployed builds.
VITE_SHOW_DEBUG_PANELS=
